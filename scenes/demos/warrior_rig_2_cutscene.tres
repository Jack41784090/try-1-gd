[sub_resource type="Resource" id="Resource_wgtq2"]
script = ExtResource("1_whrsw")
speaker_name = "Narrator"
line_spoken = "Two figures meet on the road as the light fails. Steel glints beneath travel-stained cloaks."

[sub_resource type="Resource" id="Resource_0t63b"]
