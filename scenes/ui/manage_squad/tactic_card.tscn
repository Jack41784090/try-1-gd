[gd_scene format=3]

[node name="TacticCard" type="PanelContainer"]
custom_minimum_size = Vector2(0, 90)
theme_type_variation = &"CardPanel"

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 14
theme_override_constants/margin_right = 14
theme_override_constants/margin_top = 10
theme_override_constants/margin_bottom = 10

[node name="HBox" type="HBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="InfoVBox" type="VBoxContainer" parent="Margin/HBox"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 4

[node name="NameLabel" type="Label" parent="Margin/HBox/InfoVBox"]
layout_mode = 2
theme_type_variation = &"LocationLabel"

[node name="DescLabel" type="Label" parent="Margin/HBox/InfoVBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.65, 0.65, 0.65, 1)
theme_override_font_sizes/font_size = 13
autowrap_mode = 3

[node name="StatsLabel" type="Label" parent="Margin/HBox/InfoVBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.55, 0.75, 0.55, 1)
theme_override_font_sizes/font_size = 12

[node name="ActiveLabel" type="Label" parent="Margin/HBox"]
visible = false
layout_mode = 2
size_flags_vertical = 4
theme_override_colors/font_color = Color(0.4, 0.9, 0.4, 1)
theme_override_font_sizes/font_size = 14
text = "ACTIVE"

[node name="SelectButton" type="Button" parent="Margin/HBox"]
custom_minimum_size = Vector2(80, 36)
layout_mode = 2
size_flags_vertical = 4
text = "Select"
