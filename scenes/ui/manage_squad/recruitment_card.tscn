[gd_scene format=3]

[node name="RecruitmentCard" type="PanelContainer"]
custom_minimum_size = Vector2(0, 80)
theme_type_variation = &"CardPanel"

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 10
theme_override_constants/margin_right = 10
theme_override_constants/margin_top = 8
theme_override_constants/margin_bottom = 8

[node name="HBox" type="HBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="IconRect" type="TextureRect" parent="Margin/HBox"]
custom_minimum_size = Vector2(48, 48)
layout_mode = 2
expand_mode = 2
stretch_mode = 5

[node name="InfoVBox" type="VBoxContainer" parent="Margin/HBox"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 2

[node name="NameLabel" type="Label" parent="Margin/HBox/InfoVBox"]
layout_mode = 2
theme_type_variation = &"SubsectionLabel"

[node name="CostLabel" type="Label" parent="Margin/HBox/InfoVBox"]
layout_mode = 2
theme_type_variation = &"MoneyLabel"

[node name="StatsLabel" type="Label" parent="Margin/HBox/InfoVBox"]
layout_mode = 2
theme_type_variation = &"SmallLabel"

[node name="RecruitButton" type="Button" parent="Margin/HBox"]
custom_minimum_size = Vector2(100, 36)
layout_mode = 2
size_flags_vertical = 4
text = "Recruit"
