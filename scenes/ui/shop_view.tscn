[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://src/strategy/ui/shop/view.gd" id="1_view"]
[ext_resource type="Script" path="res://src/strategy/ui/shop/presenter.gd" id="2_pres"]

[node name="ShopView" type="Control"]
visible = false
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
script = ExtResource("1_view")

[node name="OverlayPanel" type="PanelContainer" parent="."]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -400.0
offset_top = -300.0
offset_right = 400.0
offset_bottom = 300.0
grow_horizontal = 2
grow_vertical = 2
theme_type_variation = &"GamePanel"

[node name="MarginContainer" type="MarginContainer" parent="OverlayPanel"]
layout_mode = 2
theme_override_constants/margin_left = 20
theme_override_constants/margin_top = 20
theme_override_constants/margin_right = 20
theme_override_constants/margin_bottom = 20

[node name="VBoxContainer" type="VBoxContainer" parent="OverlayPanel/MarginContainer"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="TitleLabel" type="Label" parent="OverlayPanel/MarginContainer/VBoxContainer"]
layout_mode = 2
theme_type_variation = &"HeaderLabel"
text = "Shop"
horizontal_alignment = 1

[node name="MoneyLabel" type="Label" parent="OverlayPanel/MarginContainer/VBoxContainer"]
layout_mode = 2
theme_type_variation = &"SubsectionLabel"
text = "Available: 0 gold"
horizontal_alignment = 1

[node name="ScrollContainer" type="ScrollContainer" parent="OverlayPanel/MarginContainer/VBoxContainer"]
layout_mode = 2
size_flags_vertical = 3

[node name="ItemsContainer" type="VBoxContainer" parent="OverlayPanel/MarginContainer/VBoxContainer/ScrollContainer"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 8

[node name="TotalLabel" type="Label" parent="OverlayPanel/MarginContainer/VBoxContainer"]
layout_mode = 2
theme_type_variation = &"LocationLabel"
text = "Cart is empty"
horizontal_alignment = 1

[node name="ConfirmButton" type="Button" parent="OverlayPanel/MarginContainer/VBoxContainer"]
custom_minimum_size = Vector2(0, 45)
layout_mode = 2
theme_type_variation = &"ConfirmButton"
disabled = true
text = "Confirm Purchase"

[node name="CloseButton" type="Button" parent="OverlayPanel/MarginContainer/VBoxContainer"]
custom_minimum_size = Vector2(0, 45)
layout_mode = 2
theme_override_colors/font_color = Color(0.85, 0.8, 0.65, 1)
text = "Close"

[node name="ConfirmationPanel" type="PanelContainer" parent="OverlayPanel/MarginContainer"]
visible = false
layout_mode = 2
theme_type_variation = &"GamePanel"

[node name="ConfirmMargin" type="MarginContainer" parent="OverlayPanel/MarginContainer/ConfirmationPanel"]
layout_mode = 2
theme_override_constants/margin_left = 20
theme_override_constants/margin_top = 20
theme_override_constants/margin_right = 20
theme_override_constants/margin_bottom = 20

[node name="ConfirmVBox" type="VBoxContainer" parent="OverlayPanel/MarginContainer/ConfirmationPanel/ConfirmMargin"]
layout_mode = 2
theme_override_constants/separation = 15

[node name="ConfirmTitleLabel" type="Label" parent="OverlayPanel/MarginContainer/ConfirmationPanel/ConfirmMargin/ConfirmVBox"]
layout_mode = 2
theme_type_variation = &"HeaderLabel"
text = "Confirm Purchase"
horizontal_alignment = 1

[node name="SummaryContainer" type="VBoxContainer" parent="OverlayPanel/MarginContainer/ConfirmationPanel/ConfirmMargin/ConfirmVBox"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="TotalSummaryLabel" type="Label" parent="OverlayPanel/MarginContainer/ConfirmationPanel/ConfirmMargin/ConfirmVBox"]
layout_mode = 2
theme_type_variation = &"LocationLabel"
text = "Total: 0 gold"
horizontal_alignment = 1

[node name="RemainingLabel" type="Label" parent="OverlayPanel/MarginContainer/ConfirmationPanel/ConfirmMargin/ConfirmVBox"]
layout_mode = 2
theme_type_variation = &"SubsectionLabel"
text = "Remaining: 0 gold"
horizontal_alignment = 1

[node name="ButtonsHBox" type="HBoxContainer" parent="OverlayPanel/MarginContainer/ConfirmationPanel/ConfirmMargin/ConfirmVBox"]
layout_mode = 2
theme_override_constants/separation = 15
alignment = 1

[node name="PayButton" type="Button" parent="OverlayPanel/MarginContainer/ConfirmationPanel/ConfirmMargin/ConfirmVBox/ButtonsHBox"]
custom_minimum_size = Vector2(150, 50)
layout_mode = 2
theme_type_variation = &"ConfirmButton"
text = "Pay"

[node name="BackButton" type="Button" parent="OverlayPanel/MarginContainer/ConfirmationPanel/ConfirmMargin/ConfirmVBox/ButtonsHBox"]
custom_minimum_size = Vector2(150, 50)
layout_mode = 2
theme_override_colors/font_color = Color(0.85, 0.8, 0.65, 1)
theme_override_font_sizes/font_size = 18
text = "Back"

[node name="ShopPresenter" type="Node" parent="."]
script = ExtResource("2_pres")
