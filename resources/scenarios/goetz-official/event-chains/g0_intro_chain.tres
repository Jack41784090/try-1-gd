[ext_resource type="Script" uid="uid://dui3bco6g4nk4" path="res://src/strategy/ui/vn/event_chain.gd" id="1_script_event_chain"]
[ext_resource type="Script" path="res://src/strategy/ui/vn/instructions/dialogue_instruction.gd" id="2_script_dialogue_instruction"]
[ext_resource type="Script" path="res://src/strategy/ui/vn/instructions/gate_instruction.gd" id="3_script_gate_instruction"]
[ext_resource type="Script" path="res://src/strategy/ui/vn/instructions/character_instruction.gd" id="4_script_character_instruction"]
[ext_resource type="Script" path="res://src/strategy/ui/vn/instructions/stage_position.gd" id="5_script_stage_position"]

[sub_resource type="Resource" id="char_1"]
script = ExtResource("4_script_character_instruction")
action = 2
character_id = "Goetz"
behavior = "gesturing"

[sub_resource type="Resource" id="dlg_2"]
script = ExtResource("2_script_dialogue_instruction")
speaker_name = "Goetz"
line_spoken = "... ja, ja. Exactly. The Emperor is trying to make changes, but his advisors are--."

[sub_resource type="Resource" id="gate_3"]
script = ExtResource("3_script_gate_instruction")
wait_for_typewriter = true

[sub_resource type="Resource" id="dlg_4"]
script = ExtResource("2_script_dialogue_instruction")
speaker_name = "Goetz"
line_spoken = "... nooo, not the Mongols. They couldn't do anything, this time. Also, let's not--"

[sub_resource type="Resource" id="gate_5"]
script = ExtResource("3_script_gate_instruction")
wait_for_typewriter = true

[sub_resource type="Resource" id="dlg_6"]
script = ExtResource("2_script_dialogue_instruction")
line_spoken = "Two squires enter the room — Franz and Hilda. Goetz gestures for them to wait."

[sub_resource type="Resource" id="gate_7"]
script = ExtResource("3_script_gate_instruction")
wait_for_typewriter = true

[sub_resource type="Resource" id="dlg_8"]
script = ExtResource("2_script_dialogue_instruction")
speaker_name = "Goetz"
line_spoken = "Ja. But let's not say too much over the Skyline. All it's left for us is to assert ourselves."

[sub_resource type="Resource" id="gate_9"]
script = ExtResource("3_script_gate_instruction")
wait_for_typewriter = true

[sub_resource type="Resource" id="dlg_10"]
script = ExtResource("2_script_dialogue_instruction")
speaker_name = "Goetz"
line_spoken = "... likewise, talk to you later."

[sub_resource type="Resource" id="gate_11"]
script = ExtResource("3_script_gate_instruction")
wait_for_typewriter = true

[sub_resource type="Resource" id="dlg_12"]
script = ExtResource("2_script_dialogue_instruction")
speaker_name = "Franz"
line_spoken = "My Lord, my deepest apologies for interrupting you but --"

[sub_resource type="Resource" id="gate_13"]
script = ExtResource("3_script_gate_instruction")
wait_for_typewriter = true

[sub_resource type="Resource" id="dlg_14"]
script = ExtResource("2_script_dialogue_instruction")
speaker_name = "Goetz"
line_spoken = "Yeah yeah, words from Frankfurt?"

[sub_resource type="Resource" id="gate_15"]
script = ExtResource("3_script_gate_instruction")
wait_for_typewriter = true

[sub_resource type="Resource" id="dlg_16"]
script = ExtResource("2_script_dialogue_instruction")
speaker_name = "Franz"
line_spoken = "They are doubling---"

[sub_resource type="Resource" id="gate_17"]
script = ExtResource("3_script_gate_instruction")
wait_for_typewriter = true

[sub_resource type="Resource" id="dlg_18"]
script = ExtResource("2_script_dialogue_instruction")
speaker_name = "Goetz"
line_spoken = "DOUBLING DOWN???"
expression_override = "angry"

[sub_resource type="Resource" id="gate_19"]
script = ExtResource("3_script_gate_instruction")
wait_for_typewriter = true

[sub_resource type="Resource" id="dlg_20"]
script = ExtResource("2_script_dialogue_instruction")
line_spoken = "Franz stole a glance at Hilda, who gulped and glanced back at Franz."

[sub_resource type="Resource" id="gate_21"]
script = ExtResource("3_script_gate_instruction")
wait_for_typewriter = true

[sub_resource type="Resource" id="dlg_22"]
script = ExtResource("2_script_dialogue_instruction")
speaker_name = "Franz"
line_spoken = "No... my Lord, they're..."

[sub_resource type="Resource" id="gate_23"]
script = ExtResource("3_script_gate_instruction")
wait_for_typewriter = true

[sub_resource type="Resource" id="dlg_24"]
script = ExtResource("2_script_dialogue_instruction")
speaker_name = "Hilda"
line_spoken = "They said you are expressing contempt for the Empire, doubling... doubling the license fee."

[sub_resource type="Resource" id="gate_25"]
script = ExtResource("3_script_gate_instruction")
wait_for_typewriter = true

[sub_resource type="Resource" id="dlg_26"]
script = ExtResource("2_script_dialogue_instruction")
line_spoken = "Goetz fell into silence for a few seconds."

[sub_resource type="Resource" id="gate_27"]
script = ExtResource("3_script_gate_instruction")
wait_for_typewriter = true

[sub_resource type="Resource" id="dlg_28"]
script = ExtResource("2_script_dialogue_instruction")
speaker_name = "Goetz"
line_spoken = "So they *are* doubling down."

[sub_resource type="Resource" id="gate_29"]
script = ExtResource("3_script_gate_instruction")
wait_for_typewriter = true

[sub_resource type="Resource" id="dlg_30"]
script = ExtResource("2_script_dialogue_instruction")
speaker_name = "Goetz"
line_spoken = "Hilda, seal his mouth."

[sub_resource type="Resource" id="gate_31"]
script = ExtResource("3_script_gate_instruction")
wait_for_typewriter = true

[sub_resource type="Resource" id="dlg_32"]
script = ExtResource("2_script_dialogue_instruction")
speaker_name = "Goetz"
line_spoken = "What word from Nuremberg?"

[sub_resource type="Resource" id="gate_33"]
script = ExtResource("3_script_gate_instruction")
wait_for_typewriter = true

[sub_resource type="Resource" id="dlg_34"]
script = ExtResource("2_script_dialogue_instruction")
speaker_name = "Hilda"
line_spoken = "They condemned your disobedience, called you an illegal Robber Knight, my good Lord."

[sub_resource type="Resource" id="gate_35"]
script = ExtResource("3_script_gate_instruction")
wait_for_typewriter = true

[sub_resource type="Resource" id="dlg_36"]
script = ExtResource("2_script_dialogue_instruction")
speaker_name = "Goetz"
line_spoken = "Good Lord..."
expression_override = "angry"

[sub_resource type="Resource" id="gate_37"]
script = ExtResource("3_script_gate_instruction")
wait_for_typewriter = true

[sub_resource type="Resource" id="dlg_38"]
script = ExtResource("2_script_dialogue_instruction")
speaker_name = "Hilda"
line_spoken = "My lord, the villagers depend on forestry. If the license fee doubles, the foresters cannot sustain their labour. Our economic independence!"

[sub_resource type="Resource" id="gate_39"]
script = ExtResource("3_script_gate_instruction")
wait_for_typewriter = true

[sub_resource type="Resource" id="dlg_40"]
script = ExtResource("2_script_dialogue_instruction")
speaker_name = "Goetz"
line_spoken = "If they would call me a robber knight, they will get a robber knight."
expression_override = "determined"

[sub_resource type="Resource" id="gate_41"]
script = ExtResource("3_script_gate_instruction")
wait_for_typewriter = true

