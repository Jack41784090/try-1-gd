[gd_resource type="Resource" script_class="SquadBrainConfig" format=3]

[ext_resource type="Script" path="res://src/strategy/ai/squad_brain_config.gd" id="1_script"]
[ext_resource type="Script" path="res://src/strategy/ai/consideration.gd" id="2_csdr_type"]
