[gd_resource type="Resource" script_class="SquadBrainConfig" load_steps=8 format=3]

[ext_resource type="Script" path="res://src/strategy/ai/squad_brain_config.gd" id="1_script"]
[ext_resource type="Script" path="res://src/strategy/ai/consideration.gd" id="2_csdr_type"]
[ext_resource type="Resource" path="res://resources/ai/strategic/considerations/forage-when-hungry.tres" id="3_forage"]
[ext_resource type="Resource" path="res://resources/ai/strategic/considerations/travel-to-town-low-money.tres" id="4_travel"]
[ext_resource type="Resource" path="res://resources/ai/strategic/considerations/mercenary-work-low-money.tres" id="5_merc"]
[ext_resource type="Resource" path="res://resources/ai/strategic/considerations/patrol-for-info.tres" id="6_patrol"]
[ext_resource type="Resource" path="res://resources/ai/strategic/considerations/drill-when-idle.tres" id="7_drill"]
[ext_resource type="Resource" path="res://resources/ai/strategic/actions/rest.tres" id="8_fallback"]

[resource]
script = ExtResource("1_script")
profile_name = "cautious-survivor"
considerations = Array[ExtResource("2_csdr_type")]([ExtResource("3_forage"), ExtResource("4_travel"), ExtResource("5_merc"), ExtResource("6_patrol"), ExtResource("7_drill")])
fallback_action = ExtResource("8_fallback")
