[ext_resource type="Script" uid="uid://l3g17ogdf3uh" path="res://src/strategy/events/dialogue.gd" id="2_dialogue"]

[sub_resource type="Resource" id="dialogue_1"]
script = ExtResource("2_dialogue")
on_screen_character_ids = Array[String](["messenger"])
speaker_name = "Messenger"
line_spoken = "Commander! A messenger approaches bearing the seal of the local faction."
background_id = "camp_evening"

[sub_resource type="Resource" id="dialogue_2"]
script = ExtResource("2_dialogue")
on_screen_character_ids = Array[String](["messenger", "squad_leader"])
speaker_name = "Squad Leader"
line_spoken = "Let him through. What news does he bring?"
background_id = "camp_evening"

[sub_resource type="Resource" id="dialogue_3"]
script = ExtResource("2_dialogue")
on_screen_character_ids = Array[String](["messenger", "squad_leader"])
speaker_name = "Messenger"
line_spoken = "The local lords have taken notice of your religious observance. They wish to know if you stand with them... or against them."
background_id = "camp_evening"

[sub_resource type="Resource" id="dialogue_4"]
script = ExtResource("2_dialogue")
on_screen_character_ids = Array[String](["squad_leader"])
speaker_name = "Squad Leader"
line_spoken = "Tell them we fight for our own cause. But we respect all men of faith."
background_id = "camp_evening"

[resource]
script = ExtResource("1_chain")
chain_id = "faction_attention_event_chain"
chain_name = "Faction Attention"
character_ids = Array[String](["messenger", "squad_leader"])
