[sub_resource type="Resource" id="dialogue_1"]
script = ExtResource("2_dialogue")
on_screen_character_ids = Array[String](["veteran_soldier"])
speaker_name = "Veteran Soldier"
line_spoken = "Captain! Someone's approaching from the treeline. Doesn't look like trouble, but..."
background_id = "camp_evening"

[sub_resource type="Resource" id="dialogue_2"]
script = ExtResource("2_dialogue")
on_screen_character_ids = Array[String](["veteran_soldier", "stranger"])
speaker_name = "Stranger"
line_spoken = "Peace, soldiers. I mean no harm. I've been watching your patrols. Disciplined work."
background_id = "camp_evening"

[sub_resource type="Resource" id="dialogue_3"]
script = ExtResource("2_dialogue")
on_screen_character_ids = Array[String](["squad_leader", "stranger"])
speaker_name = "Squad Leader"
line_spoken = "Who are you? And why have you been watching us?"
background_id = "camp_evening"

[sub_resource type="Resource" id="dialogue_4"]
script = ExtResource("2_dialogue")
on_screen_character_ids = Array[String](["squad_leader", "stranger"])
speaker_name = "Stranger"
line_spoken = "Let's just say I'm someone who appreciates good soldiers. Here, take this. You might need it."
background_id = "camp_evening"

[sub_resource type="Resource" id="dialogue_5"]
script = ExtResource("2_dialogue")
on_screen_character_ids = Array[String](["squad_leader"])
speaker_name = "Squad Leader"
line_spoken = "Wait! ...He's gone. Strange fellow. But this gold is real enough."
background_id = "camp_evening"

[resource]
script = ExtResource("1_chain")
chain_id = "mysterious_stranger_event_chain"
