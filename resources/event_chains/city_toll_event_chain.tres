[sub_resource type="Resource" id="Resource_dialogue1"]
script = ExtResource("2_dialogue")
speaker_name = "Guard Captain"
line_spoken = "Halt! State your business and present your travel documents. All who enter this city must pay the toll."
on_screen_character_ids = Array[String]([])
background_id = ""
metadata/_custom_type_script = "uid://bqdfwjgc5yjuv"

[sub_resource type="Resource" id="Resource_dialogue2"]
script = ExtResource("2_dialogue")
speaker_name = "Narrator"
line_spoken = "The guard eyes your squad with suspicion. The toll is steep, but refusing could mean being turned away or worse."
on_screen_character_ids = Array[String]([])
background_id = ""
metadata/_custom_type_script = "uid://bqdfwjgc5yjuv"

[sub_resource type="Resource" id="Resource_dialogue3"]
script = ExtResource("2_dialogue")
speaker_name = "Guard Captain"
line_spoken = "Your papers appear to be in order. Welcome to the city. Keep your weapons sheathed and stay out of trouble."
on_screen_character_ids = Array[String]([])
background_id = ""
metadata/_custom_type_script = "uid://bqdfwjgc5yjuv"

