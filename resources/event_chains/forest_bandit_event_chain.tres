[ext_resource type="Script" uid="uid://bqdfwjgc5yjuv" path="res://src/strategy/ui/vn/dialogue.gd" id="2_dialogue"]

[sub_resource type="Resource" id="Resource_dialogue1"]
script = ExtResource("2_dialogue")
speaker_name = "Narrator"
line_spoken = "A group of armed men emerges from the forest shadows, blocking the road ahead. Their leader steps forward with a cruel smile."
on_screen_character_ids = Array[String]([])
background_id = ""
metadata/_custom_type_script = "uid://bqdfwjgc5yjuv"

[sub_resource type="Resource" id="Resource_dialogue2"]
script = ExtResource("2_dialogue")
speaker_name = "Bandit Leader"
line_spoken = "Well, well... travelers on this lonely stretch of road. Hand over your valuables and you might leave with your lives. Refuse, and we'll take everything anyway."
on_screen_character_ids = Array[String]([])
background_id = ""
metadata/_custom_type_script = "uid://bqdfwjgc5yjuv"

[sub_resource type="Resource" id="Resource_dialogue3"]
script = ExtResource("2_dialogue")
speaker_name = "Narrator"
line_spoken = "Your squad readies their weapons. This road has claimed many victims to bandits like these. Today will determine if you become another statistic or a survivor."
on_screen_character_ids = Array[String]([])
background_id = ""
metadata/_custom_type_script = "uid://bqdfwjgc5yjuv"

[resource]
script = ExtResource("1_chain")
