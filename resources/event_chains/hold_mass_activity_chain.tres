[sub_resource type="Resource" id="dialogue_1"]
script = ExtResource("2_dialogue")
on_screen_character_ids = Array[String](["squad_leader"])
speaker_name = "Squad Leader"
line_spoken = "We gather now in the sight of the Divine. Bow your heads, brothers."
background_id = "chapel"

[sub_resource type="Resource" id="dialogue_2"]
script = ExtResource("2_dialogue")
on_screen_character_ids = Array[String](["squad_leader", "priest"])
speaker_name = "Priest"
line_spoken = "Let us pray for guidance in these troubled times. May faith light our path."
background_id = "chapel"

[sub_resource type="Resource" id="dialogue_3"]
script = ExtResource("2_dialogue")
on_screen_character_ids = Array[String](["squad_leader", "priest"])
speaker_name = "Squad Leader"
line_spoken = "In battle we are tested. In prayer we are strengthened. We fight not for glory, but for a higher purpose."
background_id = "chapel"

[sub_resource type="Resource" id="dialogue_4"]
script = ExtResource("2_dialogue")
on_screen_character_ids = Array[String](["priest"])
speaker_name = "Priest"
line_spoken = "Go forth with the blessing of the righteous. May your souls remain pure even as your blades draw blood."
background_id = "chapel"

[sub_resource type="Resource" id="dialogue_5"]
script = ExtResource("2_dialogue")
on_screen_character_ids = Array[String](["squad_leader"])
speaker_name = "Squad Leader"
line_spoken = "Amen. Rise, men. The world awaits our service."
background_id = "chapel"

[resource]
script = ExtResource("1_chain")
