[sub_resource type="Resource" id="Resource_dialogue1"]
script = ExtResource("2_dialogue")
speaker_name = "Narrator"
line_spoken = "The road ahead turns into a quagmire of mud. Your carriage wheels sink deep into the mire, and the horses strain against their harnesses."
on_screen_character_ids = Array[String]([])
background_id = ""
metadata/_custom_type_script = "uid://bqdfwjgc5yjuv"

[sub_resource type="Resource" id="Resource_dialogue2"]
script = ExtResource("2_dialogue")
speaker_name = "Narrator"
line_spoken = "This is the infamous Rasputitsa - the muddy season that has trapped countless travelers. Progress slows to a crawl as you navigate the treacherous terrain."
on_screen_character_ids = Array[String]([])
background_id = ""
metadata/_custom_type_script = "uid://bqdfwjgc5yjuv"

[sub_resource type="Resource" id="Resource_dialogue3"]
script = ExtResource("2_dialogue")
speaker_name = "Narrator"
line_spoken = "After hours of grueling effort, your squad finally reaches more solid ground. The journey has taken its toll on morale and equipment."
on_screen_character_ids = Array[String]([])
background_id = ""
metadata/_custom_type_script = "uid://bqdfwjgc5yjuv"

