[sub_resource type="Resource" id="Resource_dialogue1"]
script = ExtResource("2_dialogue")
speaker_name = "Narrator"
line_spoken = "The massive walls of Smolensk loom before you - the 'Key to Moscow' stands as a testament to Russian military might. The fortress has never fallen to foreign invaders."
on_screen_character_ids = Array[String]([])
background_id = ""
metadata/_custom_type_script = "uid://bqdfwjgc5yjuv"

[sub_resource type="Resource" id="Resource_dialogue2"]
script = ExtResource("2_dialogue")
speaker_name = "Fortress Commander"
line_spoken = "You stand at the gateway to the heart of Russia. All who pass must be inspected thoroughly. We've had reports of spies and saboteurs attempting to reach Moscow."
on_screen_character_ids = Array[String]([])
background_id = ""
metadata/_custom_type_script = "uid://bqdfwjgc5yjuv"

[sub_resource type="Resource" id="Resource_dialogue3"]
script = ExtResource("2_dialogue")
speaker_name = "Narrator"
line_spoken = "After a thorough but professional inspection, you're granted passage. The road to Moscow awaits, and the end of your long journey is finally in sight."
on_screen_character_ids = Array[String]([])
background_id = ""
metadata/_custom_type_script = "uid://bqdfwjgc5yjuv"

[resource]
