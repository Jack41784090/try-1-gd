[sub_resource type="Resource" id="dlg_1"]
script = ExtResource("2_script_dialogue_instruction")
speaker_name = "Narrator"
line_spoken = "The massive walls of Smolensk loom before you - the 'Key to Moscow' stands as a testament to Russian military might. The fortress has never fallen to foreign invaders."

[sub_resource type="Resource" id="gate_2"]
