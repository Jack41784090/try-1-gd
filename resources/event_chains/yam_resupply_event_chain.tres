[gd_resource type="Resource" script_class="EventChain" load_steps=3 format=3 uid="uid://d0yam_resupply_chain"]

[ext_resource type="Script" uid="uid://dk5jxwyfvb1ks" path="res://src/strategy/vn/event_chain.gd" id="1_chain"]
[ext_resource type="Script" uid="uid://bqdfwjgc5yjuv" path="res://src/strategy/vn/dialogue.gd" id="2_dialogue"]

[sub_resource type="Resource" id="Resource_dialogue1"]
script = ExtResource("2_dialogue")
speaker_name = "Yam Master"
line_spoken = "Welcome to the yam station, travelers. Your horses look weary and your supplies are running low. We can help with that... for a price."
on_screen_character_ids = Array[String]([])
background_id = ""
metadata/_custom_type_script = "uid://bqdfwjgc5yjuv"

[sub_resource type="Resource" id="Resource_dialogue2"]
script = ExtResource("2_dialogue")
speaker_name = "Narrator"
line_spoken = "The yam station is a welcome sight after days on the road. Fresh provisions, warm beds, and news from other travelers make this a vital stop on the journey."
on_screen_character_ids = Array[String]([])
background_id = ""
metadata/_custom_type_script = "uid://bqdfwjgc5yjuv"

[sub_resource type="Resource" id="Resource_dialogue3"]
script = ExtResource("2_dialogue")
speaker_name = "Yam Master"
line_spoken = "Rest well, friends. The road ahead is long and dangerous. Many who pass through here never reach Moscow."
on_screen_character_ids = Array[String]([])
background_id = ""
metadata/_custom_type_script = "uid://bqdfwjgc5yjuv"

[resource]
script = ExtResource("1_chain")
