[sub_resource type="Resource" id="dialogue_3"]
script = ExtResource("2_dialogue")
on_screen_character_ids = Array[String](["scout"])
speaker_name = "Scout"
line_spoken = "I'll make discreet inquiries, sir. People talk when the price is right."
background_id = "city"

[sub_resource type="Resource" id="dialogue_4"]
