[sub_resource type="Resource" id="dialogue_2"]
script = ExtResource("2_dialogue")
on_screen_character_ids = Array[String](["squad_leader", "scout"])
speaker_name = "Squad Leader"
line_spoken = "Then we shall investigate. Spend the coin, ask the right questions. Knowledge is worth more than gold."
