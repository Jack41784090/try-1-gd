"morale": 15.0
}
metadata/_custom_type_script = "uid://bid5uxwt6tojw"

[resource]
script = ExtResource("2_event")
result = SubResource("Resource_result")
conditions = Array[ExtResource("1_condition")]([SubResource("Resource_condition")])
trigger_id = "moscow_arrival_event"
trigger_name = "Arrival in Moscow"
description = "After weeks of grueling travel, you finally arrive in Moscow. The golden domes of the city shine like beacons of hope."
chance = 1.0
repeats = 1
emergency_priority = 1
metadata/_custom_type_script = "uid://be7sjfrk5uh5g"
