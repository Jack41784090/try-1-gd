[gd_resource type="Resource" script_class="GameEvent" load_steps=5 format=3 uid="uid://e6moscow_arrival_event"]

[ext_resource type="Script" uid="uid://bttrmws06n1o1" path="res://src/strategy/triggerable/conditon.gd" id="1_condition"]
[ext_resource type="Script" uid="uid://be7sjfrk5uh5g" path="res://src/strategy/triggerable/game-event/script.gd" id="2_event"]
[ext_resource type="Script" uid="uid://bid5uxwt6tojw" path="res://src/strategy/triggerable/game-event/result.gd" id="3_result"]

[sub_resource type="Resource" id="Resource_condition"]
script = ExtResource("1_condition")
condition_type = 0
parameters = {
"location_id": "moscow"
}
metadata/_custom_type_script = "uid://bttrmws06n1o1"

[sub_resource type="Resource" id="Resource_result"]
script = ExtResource("3_result")
event_chain_path = "res://resources/event_chains/moscow_arrival_event_chain.tres"
