[ext_resource type="Resource" uid="uid://bf7g5wjd3jqv4" path="res://resources/combat/logic/skills/move-forward-skill.tres" id="4_movefwd"]
[ext_resource type="Resource" uid="uid://b2x3m4n5p6q7r" path="res://resources/combat/logic/skills/example-attack-skill.tres" id="5_attack"]

[sub_resource type="Resource" id="Resource_attack_csdr"]
