character_id = "veteran_soldier"
position = Vector2(75, 50)
face_direction = -1

[sub_resource type="Resource" id="dlg_1"]
script = ExtResource("2_script_dialogue_instruction")
speaker_name = "Squad Leader"
line_spoken = "We've been marching for days. The men need rest."

[sub_resource type="Resource" id="gate_2"]
script = ExtResource("3_script_gate_instruction")

[sub_resource type="Resource" id="dlg_3"]
script = ExtResource("2_script_dialogue_instruction")
speaker_name = "Veteran Soldier"
line_spoken = "Aye, Captain. My legs feel like they're made of stone."

[sub_resource type="Resource" id="gate_4"]
script = ExtResource("3_script_gate_instruction")

[sub_resource type="Resource" id="dlg_5"]
script = ExtResource("2_script_dialogue_instruction")
speaker_name = "Squad Leader"
line_spoken = "Set up camp here. We rest until dawn. Post guards and light a fire."

[sub_resource type="Resource" id="gate_6"]
script = ExtResource("3_script_gate_instruction")

[sub_resource type="Resource" id="dlg_7"]
script = ExtResource("2_script_dialogue_instruction")
speaker_name = "Veteran Soldier"
line_spoken = "Right away, sir. The men will be grateful for this."

[sub_resource type="Resource" id="gate_8"]
script = ExtResource("3_script_gate_instruction")

[resource]
script = ExtResource("1_script_event_chain")
chain_id = "rest_activity_chain"
