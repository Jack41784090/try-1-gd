[gd_resource type="Resource" script_class="GameEvent" load_steps=5 format=3]

[ext_resource type="Script" uid="uid://bttrmws06n1o1" path="res://src/strategy/core/triggerable/conditon.gd" id="1_cond"]
[ext_resource type="Script" uid="uid://be7sjfrk5uh5g" path="res://src/strategy/core/triggerable/game_event/script.gd" id="2_event"]
[ext_resource type="Script" uid="uid://bid5uxwt6tojw" path="res://src/strategy/core/triggerable/game_event/result.gd" id="3_result"]

[sub_resource type="Resource" id="cond_morale"]
script = ExtResource("1_cond")
