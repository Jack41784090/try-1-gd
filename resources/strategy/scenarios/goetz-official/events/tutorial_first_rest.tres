[gd_resource type="Resource" script_class="GameEvent" load_steps=6 format=3]

[ext_resource type="Script" uid="uid://bttrmws06n1o1" path="res://src/strategy/core/triggerable/conditon.gd" id="1_cond"]
[ext_resource type="Script" uid="uid://be7sjfrk5uh5g" path="res://src/strategy/core/triggerable/game-event/script.gd" id="2_event"]
[ext_resource type="Script" uid="uid://bid5uxwt6tojw" path="res://src/strategy/core/triggerable/game-event/result.gd" id="3_result"]

[sub_resource type="Resource" id="cond_activity"]
script = ExtResource("1_cond")
condition_type = 4
parameters = {
"activity_type": 0
}
metadata/_custom_type_script = "uid://bttrmws06n1o1"

[sub_resource type="Resource" id="cond_time"]
script = ExtResource("1_cond")
condition_type = 5
parameters = {
"turn_min": 0,
"turn_max": 192
}
metadata/_custom_type_script = "uid://bttrmws06n1o1"

[sub_resource type="Resource" id="result"]
script = ExtResource("3_result")
event_chain_path = "res://resources/scenarios/goetz-official/event-chains/tutorials/tutorial_first_rest_chain.tres"
requires_async = true
metadata/_custom_type_script = "uid://bid5uxwt6tojw"

[resource]
script = ExtResource("2_event")
trigger_id = "tutorial_first_rest"
trigger_name = "First Rest Tutorial"
conditions = Array[ExtResource("1_cond")]([SubResource("cond_activity"), SubResource("cond_time")])
result = SubResource("result")
when_to_trigger = 1
repeats = 1
metadata/_custom_type_script = "uid://be7sjfrk5uh5g"
