[gd_resource type="Resource" script_class="EventChain" load_steps=29 format=3]

[ext_resource type="Script" uid="uid://dui3bco6g4nk4" path="res://src/strategy/ui/vn/event_chain.gd" id="1_script_event_chain"]
[ext_resource type="Script" path="res://src/strategy/ui/vn/instructions/dialogue_instruction.gd" id="2_script_dialogue_instruction"]
[ext_resource type="Script" path="res://src/strategy/ui/vn/instructions/gate_instruction.gd" id="3_script_gate_instruction"]
[ext_resource type="Script" path="res://src/strategy/ui/vn/instructions/stage_position.gd" id="4_script_stage_position"]

[sub_resource type="Resource" id="dlg_1"]
script = ExtResource("2_script_dialogue_instruction")
speaker_name = "Goetz"
line_spoken = "Bring your best, you cowards who hide behind your walls!"
expression_override = "angry"

[sub_resource type="Resource" id="gate_2"]
script = ExtResource("3_script_gate_instruction")
wait_for_typewriter = true

[sub_resource type="Resource" id="dlg_3"]
script = ExtResource("2_script_dialogue_instruction")
speaker_name = "Nuremberg Official"
line_spoken = "The Bishop will send his army, and your charade will be put down, alongside with those foolish enough to follow you."

[sub_resource type="Resource" id="gate_4"]
script = ExtResource("3_script_gate_instruction")
wait_for_typewriter = true

[sub_resource type="Resource" id="dlg_5"]
script = ExtResource("2_script_dialogue_instruction")
speaker_name = "Goetz"
line_spoken = "The Bishop will have to send his best against the Emperor's most loyal!"
expression_override = "determined"

[sub_resource type="Resource" id="gate_6"]
script = ExtResource("3_script_gate_instruction")
wait_for_typewriter = true

[sub_resource type="Resource" id="dlg_7"]
script = ExtResource("2_script_dialogue_instruction")
speaker_name = "Nuremberg Official"
line_spoken = "The Emperor assigned our Bishop to rule over this city. If you truly consider yourself loyal to the Emperor, you will not challenge His Holiness."

[sub_resource type="Resource" id="gate_8"]
script = ExtResource("3_script_gate_instruction")
wait_for_typewriter = true

[sub_resource type="Resource" id="dlg_9"]
script = ExtResource("2_script_dialogue_instruction")
speaker_name = "Goetz"
line_spoken = "Are you happy sitting behind the desk, signing away your life on paperwork? How many lives do you have before we head into the afterlife facing God Almighty, and we have to tell him what we have done for him on Earth? Exactly, One!"
expression_override = "gesturing"

[sub_resource type="Resource" id="gate_10"]
script = ExtResource("3_script_gate_instruction")
wait_for_typewriter = true

[sub_resource type="Resource" id="dlg_11"]
script = ExtResource("2_script_dialogue_instruction")
speaker_name = "Nuremberg Official"
line_spoken = "And you have spent yours antagonizing good citizens of Nuremberg and the whole of Germany, Goetz."

[sub_resource type="Resource" id="gate_12"]
script = ExtResource("3_script_gate_instruction")
wait_for_typewriter = true

[sub_resource type="Resource" id="dlg_13"]
script = ExtResource("2_script_dialogue_instruction")
speaker_name = "Goetz"
line_spoken = "I serve under Frederick the Emperor himself, and you under a coward hiding behind his position in a tyrannical theocracy."
expression_override = "angry"

[sub_resource type="Resource" id="gate_14"]
script = ExtResource("3_script_gate_instruction")
wait_for_typewriter = true

[sub_resource type="Resource" id="dlg_15"]
script = ExtResource("2_script_dialogue_instruction")
speaker_name = "Goetz"
line_spoken = "That fat lump of flesh fancies himself Lord of his own realm, claiming the hardwork of good hardworking peasants to pay for his luxury. Is this what a \"heavenly\" man is?"

[sub_resource type="Resource" id="gate_16"]
script = ExtResource("3_script_gate_instruction")
wait_for_typewriter = true

[sub_resource type="Resource" id="dlg_17"]
script = ExtResource("2_script_dialogue_instruction")
speaker_name = "Goetz"
line_spoken = "I do not fight the Emperor; I do not fight the Reich; I fight tyrants under the Holy Rights of Landfrieden."
expression_override = "determined"

[sub_resource type="Resource" id="gate_18"]
script = ExtResource("3_script_gate_instruction")
wait_for_typewriter = true

[sub_resource type="Resource" id="dlg_19"]
script = ExtResource("2_script_dialogue_instruction")
speaker_name = "Nuremberg Official"
line_spoken = "Goetz, you are a relic of the past. We've been telling you for months that Landfrieden has been revoked from you and every knight of the Reich."

[sub_resource type="Resource" id="gate_20"]
script = ExtResource("3_script_gate_instruction")
wait_for_typewriter = true

[sub_resource type="Resource" id="dlg_21"]
script = ExtResource("2_script_dialogue_instruction")
speaker_name = "Nuremberg Official"
line_spoken = "I hope soon the Reich will do away with Reichsritter like you.\n\nPrepare yourself!"
expression_override = "angry"

[sub_resource type="Resource" id="gate_22"]
script = ExtResource("3_script_gate_instruction")
wait_for_typewriter = true

[sub_resource type="Resource" id="pos_23"]
script = ExtResource("4_script_stage_position")
character_id = "goetz"
position = Vector2(-75.0, 50)
face_direction = 1

[sub_resource type="Resource" id="pos_24"]
script = ExtResource("4_script_stage_position")
